# SAHAYAK Backend Environment Variables Example
# Copy this file to .env or export these variables in your runtime environment.
# NEVER commit actual secrets or passwords to version control.

PORT=8080

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sahayak_db
SPRING_DATASOURCE_USERNAME=sahayak_user
SPRING_DATASOURCE_PASSWORD=<REPLACE_WITH_SECURE_DB_PASSWORD>

# JWT Security Configuration (Base64-encoded 256-bit+ secret)
JWT_SECRET=<REPLACE_WITH_BASE64_256_BIT_SECRET>
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
